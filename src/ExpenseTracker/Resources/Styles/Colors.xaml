<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Grafite e Avorio: superfici neutre e azioni gialle. -->
    <Color x:Key="Primary">#FFD21F</Color>
    <Color x:Key="PrimaryDark">#17181B</Color>
    <Color x:Key="PrimarySoft">#FFF2B3</Color>
    <Color x:Key="PrimaryGlow">#FFD21F</Color>

    <Color x:Key="White">#F4F0E7</Color>
    <Color x:Key="OffWhite">#F4F0E7</Color>
    <Color x:Key="Black">#17181B</Color>
    <Color x:Key="OffBlack">#17181B</Color>
    <Color x:Key="Charcoal">#25262A</Color>
    <Color x:Key="Graphite">#303136</Color>

    <Color x:Key="LightBackground">#F5F2EA</Color>
    <Color x:Key="LightSurface">#FFFFFF</Color>
    <Color x:Key="LightSurfaceAlt">#EBE7DE</Color>
    <Color x:Key="LightText">#242529</Color>
    <Color x:Key="LightTextMuted">#62625F</Color>
    <Color x:Key="LightBorder">#DCD7CE</Color>

    <Color x:Key="DarkBackground">#17181B</Color>
    <Color x:Key="DarkSurface">#25262A</Color>
    <Color x:Key="DarkSurfaceAlt">#303136</Color>
    <Color x:Key="DarkText">#F4F0E7</Color>
    <Color x:Key="DarkTextMuted">#B4B2AC</Color>
    <Color x:Key="DarkBorder">#3C3D42</Color>

    <Color x:Key="Income">#A7C38A</Color>
    <Color x:Key="Expense">#E7A088</Color>
    <Color x:Key="Warning">#FFD21F</Color>
    <Color x:Key="Info">#A5B8CC</Color>

    <Color x:Key="Gray100">#ECEDEF</Color>
    <Color x:Key="Gray200">#D9DBDF</Color>
    <Color x:Key="Gray300">#B9BDC4</Color>
    <Color x:Key="Gray400">#9297A1</Color>
    <Color x:Key="Gray500">#737985</Color>
    <Color x:Key="Gray600">#4C515B</Color>
    <Color x:Key="Gray900">#202329</Color>
    <Color x:Key="Gray950">#121419</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="IncomeBrush" Color="{StaticResource Income}" />
    <SolidColorBrush x:Key="ExpenseBrush" Color="{StaticResource Expense}" />
</ResourceDictionary>
