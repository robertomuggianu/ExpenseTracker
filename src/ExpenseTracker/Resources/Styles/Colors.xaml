<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Petrolio e ambra, con superfici verdi e testi avorio. -->
    <Color x:Key="Primary">#42C6A5</Color>
    <Color x:Key="PrimaryDark">#214F46</Color>
    <Color x:Key="PrimarySoft">#E2F3EB</Color>
    <Color x:Key="PrimaryGlow">#80D9BE</Color>

    <Color x:Key="White">#F6F2E7</Color>
    <Color x:Key="OffWhite">#F6F2E7</Color>
    <Color x:Key="Black">#101C19</Color>
    <Color x:Key="OffBlack">#101C19</Color>
    <Color x:Key="Charcoal">#26342F</Color>
    <Color x:Key="Graphite">#32443C</Color>

    <Color x:Key="LightBackground">#F4F3EB</Color>
    <Color x:Key="LightSurface">#F6F2E7</Color>
    <Color x:Key="LightSurfaceAlt">#E8EEE8</Color>
    <Color x:Key="LightText">#172D25</Color>
    <Color x:Key="LightTextMuted">#617469</Color>
    <Color x:Key="LightBorder">#D7E2D9</Color>

    <Color x:Key="DarkBackground">#101C19</Color>
    <Color x:Key="DarkSurface">#26342F</Color>
    <Color x:Key="DarkSurfaceAlt">#32443C</Color>
    <Color x:Key="DarkText">#F6F2E7</Color>
    <Color x:Key="DarkTextMuted">#B2C4B8</Color>
    <Color x:Key="DarkBorder">#3C5147</Color>

    <Color x:Key="Income">#80D9BE</Color>
    <Color x:Key="Expense">#F2AA91</Color>
    <Color x:Key="Warning">#F4C66A</Color>
    <Color x:Key="Info">#8ABCD1</Color>

    <Color x:Key="Gray100">#ECEDEF</Color>
    <Color x:Key="Gray200">#D9DBDF</Color>
    <Color x:Key="Gray300">#B9BDC4</Color>
    <Color x:Key="Gray400">#9297A1</Color>
    <Color x:Key="Gray500">#737985</Color>
    <Color x:Key="Gray600">#4C515B</Color>
    <Color x:Key="Gray900">#202329</Color>
    <Color x:Key="Gray950">#121419</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="IncomeBrush" Color="{StaticResource Income}" />
    <SolidColorBrush x:Key="ExpenseBrush" Color="{StaticResource Expense}" />
</ResourceDictionary>
