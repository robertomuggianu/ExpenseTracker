<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Tema scuro con accenti viola e colori vivaci per le categorie. -->
    <Color x:Key="Primary">#8B5CF6</Color>
    <Color x:Key="PrimaryDark">#211A35</Color>
    <Color x:Key="PrimarySoft">#EDE9FE</Color>
    <Color x:Key="PrimaryGlow">#C4B5FD</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="OffWhite">#F7F7F8</Color>
    <Color x:Key="Black">#0C0F18</Color>
    <Color x:Key="OffBlack">#101216</Color>
    <Color x:Key="Charcoal">#181B20</Color>
    <Color x:Key="Graphite">#24282F</Color>

    <Color x:Key="LightBackground">#F5F3F3</Color>
    <Color x:Key="LightSurface">#FFFFFF</Color>
    <Color x:Key="LightSurfaceAlt">#F0ECEC</Color>
    <Color x:Key="LightText">#17181C</Color>
    <Color x:Key="LightTextMuted">#686B73</Color>
    <Color x:Key="LightBorder">#E3DDDE</Color>

    <Color x:Key="DarkBackground">#0C0F18</Color>
    <Color x:Key="DarkSurface">#171C2B</Color>
    <Color x:Key="DarkSurfaceAlt">#222A3C</Color>
    <Color x:Key="DarkText">#F7F7F8</Color>
    <Color x:Key="DarkTextMuted">#A9ADB6</Color>
    <Color x:Key="DarkBorder">#2B3448</Color>

    <Color x:Key="Income">#34D399</Color>
    <Color x:Key="Expense">#FB7185</Color>
    <Color x:Key="Warning">#F4B942</Color>
    <Color x:Key="Info">#5AA9FF</Color>

    <Color x:Key="Gray100">#ECEDEF</Color>
    <Color x:Key="Gray200">#D9DBDF</Color>
    <Color x:Key="Gray300">#B9BDC4</Color>
    <Color x:Key="Gray400">#9297A1</Color>
    <Color x:Key="Gray500">#737985</Color>
    <Color x:Key="Gray600">#4C515B</Color>
    <Color x:Key="Gray900">#202329</Color>
    <Color x:Key="Gray950">#121419</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="IncomeBrush" Color="{StaticResource Income}" />
    <SolidColorBrush x:Key="ExpenseBrush" Color="{StaticResource Expense}" />
</ResourceDictionary>
