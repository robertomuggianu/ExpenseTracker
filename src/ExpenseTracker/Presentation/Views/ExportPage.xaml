<?xml version="1.0" encoding="utf-8" ?>
<ContentPage Shell.NavBarIsVisible="False"
    x:Class="ExpenseTracker.Presentation.Views.ExportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ExpenseTracker.Presentation.Controls"
    Title="Dati">
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <controls:PageHeader Heading="Esporta e importa"/>

            <VerticalStackLayout Padding="18,14,18,100" Spacing="14">
                <Border Style="{StaticResource Card}" Stroke="{StaticResource Primary}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                            <Border WidthRequest="48" HeightRequest="48" Padding="0" BackgroundColor="{DynamicResource SurfaceAltColor}" StrokeThickness="0" StrokeShape="RoundRectangle 15">
                                <Label Text="⇧" TextColor="{DynamicResource AccentTextColor}" FontSize="25" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Importa lo storico" FontSize="18" FontAttributes="Bold" />
                                <Label Text="Compatibile con Excel e CSV." Style="{StaticResource MutedLabel}" FontSize="13" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="Il formato dell'app precedente viene riconosciuto automaticamente. Conti e categorie mancanti vengono creati. La reimportazione dello stesso file conserva i movimenti; file esterni modificati possono produrre nuovi movimenti."
                               Style="{StaticResource MutedLabel}" FontSize="13" LineHeight="1.2" />
                        <Button Text="Scegli file e importa" Command="{Binding ImportCommand}" />
                        <Label Style="{StaticResource FeedbackLabel}" Text="{Binding ImportSummary}" TextColor="{DynamicResource IncomeColor}" FontAttributes="Bold" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Esporta tutto" FontAttributes="Bold" FontSize="16" />
                            <Label Text="Disattiva per scegliere i filtri." Style="{StaticResource MutedLabel}" FontSize="12" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding ExportAll}" VerticalOptions="Center" SemanticProperties.Description="Esporta tutti i movimenti" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" IsVisible="{Binding UseExportFilters}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Filtri esportazione" FontSize="17" FontAttributes="Bold" />
                        <controls:ChoiceField ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Label" Title="Periodo" />
                        <Grid IsVisible="{Binding IsCustomPeriod}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                            <Label Text="Dal" Style="{StaticResource MutedLabel}" FontSize="12" />
                            <Label Grid.Column="1" Text="Al" Style="{StaticResource MutedLabel}" FontSize="12" />
                            <Border Grid.Row="1" Style="{StaticResource InputCard}"><DatePicker Date="{Binding CustomFrom}" Format="dd/MM/yyyy" SemanticProperties.Description="Data iniziale dell'esportazione" /></Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InputCard}"><DatePicker Date="{Binding CustomTo}" Format="dd/MM/yyyy" SemanticProperties.Description="Data finale dell'esportazione" /></Border>
                        </Grid>
                        <controls:ChoiceField ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="Name" Title="Conto" />
                        <controls:ChoiceField ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Label" Title="Tipo" />
                        <controls:ChoiceField ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Title="Categoria" />
                        <Label Text="Per reimportare i movimenti, scegli «Esporta tutto». I filtri possono escludere una delle due registrazioni di un trasferimento." Style="{StaticResource MutedLabel}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Crea e condividi CSV" Command="{Binding ExportCommand}" FontSize="16" />
                <Label Style="{StaticResource FeedbackLabel}" Text="{Binding ErrorMessage}" TextColor="{DynamicResource ExpenseColor}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
