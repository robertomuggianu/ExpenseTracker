<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Presentation.Views.ExportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ExpenseTracker.Presentation.Controls"
    Title="Dati">
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <controls:PageHeader Heading="Esporta e importa" Subtitle="Porta con te i tuoi dati"/>

            <VerticalStackLayout Padding="16,14,16,32" Spacing="12">
                <Border Style="{StaticResource Card}" Stroke="{StaticResource Primary}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                            <Border WidthRequest="48" HeightRequest="48" Padding="0" BackgroundColor="#2642C6A5" StrokeThickness="0" StrokeShape="RoundRectangle 15">
                                <Label Text="⇧" TextColor="{StaticResource PrimaryGlow}" FontSize="25" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Importa lo storico" FontSize="18" FontAttributes="Bold" />
                                <Label Text="Compatibile con Excel (.xlsx) e CSV." Style="{StaticResource MutedLabel}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="Il formato dell'app precedente viene riconosciuto automaticamente. Conti e categorie mancanti vengono creati. La reimportazione dello stesso file conserva i movimenti; file esterni modificati possono produrre nuovi movimenti."
                               Style="{StaticResource MutedLabel}" FontSize="13" LineHeight="1.2" />
                        <Button Text="Scegli file e importa" Command="{Binding ImportCommand}" />
                        <Label Text="{Binding ImportSummary}" TextColor="{StaticResource Income}" FontAttributes="Bold" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Esporta CSV" Style="{StaticResource SectionTitle}" VerticalTextAlignment="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding ExportAll}" VerticalOptions="Center" />
                </Grid>
                <Label Text="Esporta tutti i movimenti oppure disattiva l'interruttore per usare i filtri."
                       Style="{StaticResource MutedLabel}" FontSize="12" />

                <Border Style="{StaticResource Card}" Padding="14" IsVisible="{Binding UseExportFilters}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Filtri esportazione" FontSize="17" FontAttributes="Bold" />
                        <controls:ChoiceField ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Label" Title="Periodo" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border Style="{StaticResource InputCard}"><DatePicker Date="{Binding CustomFrom}" /></Border>
                            <Border Grid.Column="1" Style="{StaticResource InputCard}"><DatePicker Date="{Binding CustomTo}" /></Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <controls:ChoiceField ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="Name" Title="Conto" />
                            <controls:ChoiceField Grid.Column="1" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Label" Title="Tipo" />
                        </Grid>
                        <controls:ChoiceField ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Title="Categoria" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Crea e condividi CSV" Command="{Binding ExportCommand}" FontSize="16" />
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
