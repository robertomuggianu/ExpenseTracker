<?xml version="1.0" encoding="utf-8"?>
<ContentPage Shell.NavBarIsVisible="False" xmlns:controls="clr-namespace:ExpenseTracker.Presentation.Controls" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ExpenseTracker.Presentation.Views.DashboardPage" x:Name="Page" Title="Home">
  <Grid x:Name="HomeLayout" RowDefinitions="Auto,*">
    <Border x:Name="HomeHeader" Style="{StaticResource HeaderCard}" Padding="18,8,18,16">
      <VerticalStackLayout Spacing="10">
        <Label Text="{Binding AccountScope.Summary}" TextColor="{DynamicResource MutedColor}" FontSize="13" HorizontalTextAlignment="Center" Margin="0,4,0,-4"/>
        <Grid ColumnDefinitions="44,*,44,44" ColumnSpacing="2">
          <Button AutomationId="Navigation.Menu" Style="{StaticResource HeaderMenuButton}" Command="{Binding OpenMenuCommand}" SemanticProperties.Description="Apri menu"/>
          <Label AutomationId="Home.Balance" Grid.Column="1" Text="{Binding BalanceText}" Style="{StaticResource HeroValue}" FontSize="30" HorizontalTextAlignment="Center"
                 VerticalTextAlignment="Center" SemanticProperties.Description="{Binding BalanceAccessibilityText}"/>
          <Button Grid.Column="2" AutomationId="Home.Account" ImageSource="{DynamicResource menu_walletSource}" Clicked="OnChooseAccountClicked"
                  Style="{StaticResource TextButton}" WidthRequest="44" HeightRequest="44" Padding="10" SemanticProperties.Description="Cambia conto per tutta l'app"/>
          <Button Grid.Column="3" ImageSource="{DynamicResource ui_eyeSource}" Command="{Binding ToggleBalanceVisibilityCommand}"
                  Style="{StaticResource TextButton}" WidthRequest="44" HeightRequest="44" Padding="10" TextColor="{DynamicResource TextColor}"
                  SemanticProperties.Description="{Binding BalanceVisibilityDescription}">
            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsBalanceHidden}" Value="True"><Setter Property="ImageSource" Value="{DynamicResource ui_eye_offSource}"/></DataTrigger></Button.Triggers>
          </Button>
        </Grid>
        <Border Padding="4" BackgroundColor="{DynamicResource SurfaceAltColor}" StrokeShape="RoundRectangle 17">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
          <Button Text="Spese" Style="{StaticResource ReportTab}" Command="{Binding SelectExpensesCommand}">
            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsExpenseSelected}" Value="True"><Setter Property="TextColor" Value="{StaticResource DarkBackground}"/><Setter Property="BackgroundColor" Value="{StaticResource PrimaryGlow}"/></DataTrigger></Button.Triggers>
          </Button>
          <Button Grid.Column="1" Text="Entrate" Style="{StaticResource ReportTab}" Command="{Binding SelectIncomeCommand}">
            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsIncomeSelected}" Value="True"><Setter Property="TextColor" Value="{StaticResource DarkBackground}"/><Setter Property="BackgroundColor" Value="{StaticResource PrimaryGlow}"/></DataTrigger></Button.Triggers>
          </Button>
        </Grid>
        </Border>
      </VerticalStackLayout>
    </Border>
    <Grid x:Name="ReportViewport" Grid.Row="1" Margin="0">
      <ScrollView x:Name="HomeScroll" Scrolled="OnHomeScrolled">
        <VerticalStackLayout x:Name="ReportContent" Padding="18,0,18,100" Spacing="12">
          <controls:DashboardSummary x:Name="ExpandedSummary"/>

          <VerticalStackLayout BindableLayout.ItemsSource="{Binding CategoryBreakdown}" Spacing="4">
            <BindableLayout.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Padding="12">
                  <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenCategoryCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers>
                  <Grid ColumnDefinitions="42,*,Auto,Auto" ColumnSpacing="10">
                    <Border WidthRequest="42" HeightRequest="42" Padding="10" BackgroundColor="{Binding Color}" StrokeShape="RoundRectangle 14"><Image Source="{Binding IconSource}"/></Border>
                    <Label Grid.Column="1" Text="{Binding Name}" FontSize="15" FontAttributes="Bold" VerticalTextAlignment="Center" LineBreakMode="TailTruncation"/>
                    <Label Grid.Column="2" Text="{Binding Percentage}" Style="{StaticResource MutedLabel}" FontSize="13" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="3" FontSize="15" FontAttributes="Bold" VerticalTextAlignment="Center">
                      <Label.Text><MultiBinding Converter="{StaticResource MoneyConverter}"><Binding Path="Total"/><Binding Path="Currency"/></MultiBinding></Label.Text>
                    </Label>
                  </Grid>
                </Border>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>
          <Border Style="{StaticResource Card}" Padding="16">
            <Grid ColumnDefinitions="*,Auto">
              <VerticalStackLayout Spacing="3"><Label Text="Differenza del periodo" FontAttributes="Bold"/><Label Text="Entrate − spese" Style="{StaticResource MutedLabel}" FontSize="12"/></VerticalStackLayout>
              <Label Grid.Column="1" TextColor="{DynamicResource AccentTextColor}" FontSize="20" FontAttributes="Bold" VerticalTextAlignment="Center">
                <Label.Text><MultiBinding Converter="{StaticResource MoneyConverter}"><Binding Path="Difference"/><Binding Path="ReportCurrency"/></MultiBinding></Label.Text>
              </Label>
            </Grid>
          </Border>
          <Label Style="{StaticResource FeedbackLabel}" Text="{Binding BalanceWarning}" TextColor="{DynamicResource ExpenseColor}"/>
          <Label Text="{Binding ComparisonText}" Style="{StaticResource MutedLabel}" FontSize="12" Margin="2,4"/>
          <Label Style="{StaticResource FeedbackLabel}" Text="{Binding ErrorMessage}" TextColor="{DynamicResource ExpenseColor}"/>
          <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
        </VerticalStackLayout>
      </ScrollView>
      <controls:DashboardSummary x:Name="CompactSummary" IsCompact="True" Opacity="0" InputTransparent="True"
                                 Margin="18,0" VerticalOptions="Start" ZIndex="1"/>
    </Grid>
    <Button Grid.RowSpan="2" Style="{StaticResource FloatingActionButton}" Command="{Binding NewTransactionCommand}" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,22,24" SemanticProperties.Description="Aggiungi un movimento"/>
  </Grid>
</ContentPage>
