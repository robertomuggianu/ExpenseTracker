<?xml version='1.0' encoding='utf-8'?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui" x:Class="ExpenseTracker.Presentation.Views.DashboardPage" Title="Mese">
  <Grid>
    <ScrollView>
      <VerticalStackLayout Padding="20,22,20,100" Spacing="18">
        <Grid ColumnDefinitions="*,Auto">
          <VerticalStackLayout Spacing="2">
            <Label Text="IL TUO MESE" Style="{StaticResource Eyebrow}"/>
            <Label Text="{Binding MonthLabel}" Style="{StaticResource PageTitle}" TextTransform="None"/>
          </VerticalStackLayout>
          <Button Grid.Column="1" Text="Oggi" Command="{Binding CurrentMonthCommand}" Style="{StaticResource TextButton}"/>
        </Grid>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Button Text="‹" Command="{Binding PreviousMonthCommand}" Style="{StaticResource SecondaryButton}" SemanticProperties.Description="Mese precedente"/>
          <Label Grid.Column="1" Text="{Binding MonthLabel}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontAttributes="Bold"/>
          <Button Grid.Column="2" Text="›" Command="{Binding NextMonthCommand}" Style="{StaticResource SecondaryButton}" SemanticProperties.Description="Mese successivo"/>
        </Grid>
        <Border Style="{StaticResource HeroCard}">
          <VerticalStackLayout Spacing="8">
            <Label Text="Spese del mese" TextColor="{StaticResource DarkTextMuted}"/>
            <Label Style="{StaticResource HeroValue}">
              <Label.Text>
                <MultiBinding Converter="{StaticResource MoneyConverter}">
                  <Binding Path="Expense"/>
                  <Binding Path="ReportCurrency"/>
                </MultiBinding>
              </Label.Text>
            </Label>
            <Label Text="{Binding ComparisonText}" TextColor="{StaticResource PrimaryGlow}" FontSize="13"/>
          </VerticalStackLayout>
        </Border>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Border Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="6">
              <Label Text="Entrate" TextColor="{StaticResource Income}"/>
              <Label FontSize="23" FontAttributes="Bold">
                <Label.Text>
                  <MultiBinding Converter="{StaticResource MoneyConverter}">
                    <Binding Path="Income"/>
                    <Binding Path="ReportCurrency"/>
                  </MultiBinding>
                </Label.Text>
              </Label>
            </VerticalStackLayout>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="6">
              <Label Text="Differenza" TextColor="{StaticResource PrimaryGlow}"/>
              <Label FontSize="23" FontAttributes="Bold">
                <Label.Text>
                  <MultiBinding Converter="{StaticResource MoneyConverter}">
                    <Binding Path="Difference"/>
                    <Binding Path="ReportCurrency"/>
                  </MultiBinding>
                </Label.Text>
              </Label>
              <Label Text="Entrate − spese" Style="{StaticResource MutedLabel}" FontSize="11"/>
            </VerticalStackLayout>
          </Border>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <Label Text="Saldo dei conti" Style="{StaticResource MutedLabel}" VerticalTextAlignment="Center"/>
          <Label Grid.Column="1" FontAttributes="Bold">
            <Label.Text>
              <MultiBinding Converter="{StaticResource MoneyConverter}">
                <Binding Path="TotalBalance"/>
                <Binding Path="BalanceCurrency"/>
              </MultiBinding>
            </Label.Text>
          </Label>
        </Grid>
        <Label Text="Dove hai speso" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource Card}" IsVisible="{Binding HasExpenseData}">
          <lvc:PieChart Series="{Binding ExpenseSeries}" HeightRequest="260" LegendPosition="Bottom"/>
        </Border>
        <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoExpenseData}">
          <Label Text="Le categorie compariranno qui quando registri la prima spesa del mese." Style="{StaticResource MutedLabel}"/>
        </Border>
        <Grid ColumnDefinitions="*,Auto">
          <Label Text="Ultimi movimenti" Style="{StaticResource SectionTitle}" VerticalTextAlignment="Center"/>
          <Button Grid.Column="1" Text="Tutti ›" Style="{StaticResource TextButton}" Command="{Binding ShowTransactionsCommand}"/>
        </Grid>
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentTransactions}" Spacing="10">
          <BindableLayout.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Padding="14">
                <Grid ColumnDefinitions="44,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                  <Border Grid.RowSpan="2" WidthRequest="44" HeightRequest="44" Padding="10" StrokeThickness="0" BackgroundColor="{Binding CategoryColor}" StrokeShape="RoundRectangle 16">
                    <Image Source="{Binding IconSource}"/>
                  </Border>
                  <Label Grid.Column="1" Text="{Binding DisplayDescription}" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                  <Label Grid.Column="2" FontAttributes="Bold">
                    <Label.Text>
                      <MultiBinding Converter="{StaticResource MoneyConverter}">
                        <Binding Path="SignedAmount"/>
                        <Binding Path="Transaction.Currency"/>
                      </MultiBinding>
                    </Label.Text>
                  </Label>
                  <Label Grid.Row="1" Grid.Column="1" Text="{Binding CategoryName}" Style="{StaticResource MutedLabel}" FontSize="12"/>
                  <Label Grid.Row="1" Grid.Column="2" Text="{Binding LocalDate, StringFormat='{0:dd MMM}'}" Style="{StaticResource MutedLabel}" FontSize="12"/>
                </Grid>
              </Border>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
        <Label Text="Nessun movimento in questo mese." IsVisible="{Binding HasNoRecentTransactions}" Style="{StaticResource MutedLabel}"/>
        <Button Text="Esporta questo mese in CSV" Style="{StaticResource SecondaryButton}" Command="{Binding ExportMonthCommand}"/>
        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}"/>
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
      </VerticalStackLayout>
    </ScrollView>
    <Button Style="{StaticResource FloatingActionButton}" Command="{Binding NewTransactionCommand}" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,22,20" SemanticProperties.Description="Aggiungi una spesa"/>
  </Grid>
</ContentPage>
