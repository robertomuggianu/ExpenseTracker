<?xml version="1.0" encoding="utf-8"?>
<ContentPage Shell.NavBarIsVisible="False" xmlns:controls="clr-namespace:ExpenseTracker.Presentation.Controls" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui" x:Class="ExpenseTracker.Presentation.Views.DashboardPage" x:Name="Page" Title="Home">
  <Grid>
    <ScrollView>
      <VerticalStackLayout Spacing="0">
        <Border Style="{StaticResource HeaderCard}" Padding="18,14,18,38">
          <VerticalStackLayout Spacing="12">
            <Grid ColumnDefinitions="46,*,46">
              <Button Style="{StaticResource HeaderMenuButton}" Command="{Binding OpenMenuCommand}" SemanticProperties.Description="Apri menu"/>
              <Label Grid.Column="1" Text="ExpenseTracker" FontSize="21" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
              <Image Grid.Column="2" Source="brand_mark.png" WidthRequest="46" HeightRequest="46"/>
            </Grid>
            <VerticalStackLayout Spacing="3">
              <Label Text="SALDO DEI CONTI" Style="{StaticResource Eyebrow}" HorizontalTextAlignment="Center" TextColor="{StaticResource DarkTextMuted}" FontSize="10"/>
              <Label Style="{StaticResource HeroValue}" FontSize="34" HorizontalTextAlignment="Center">
                <Label.Text><MultiBinding Converter="{StaticResource MoneyConverter}"><Binding Path="TotalBalance"/><Binding Path="BalanceCurrency"/></MultiBinding></Label.Text>
              </Label>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <Button Text="SPESE" Style="{StaticResource ReportTab}" Command="{Binding SelectExpensesCommand}">
                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsExpenseSelected}" Value="True"><Setter Property="TextColor" Value="{StaticResource DarkText}"/><Setter Property="BackgroundColor" Value="#3442C6A5"/></DataTrigger></Button.Triggers>
              </Button>
              <Button Grid.Column="1" Text="ENTRATE" Style="{StaticResource ReportTab}" Command="{Binding SelectIncomeCommand}">
                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsIncomeSelected}" Value="True"><Setter Property="TextColor" Value="{StaticResource DarkText}"/><Setter Property="BackgroundColor" Value="#3442C6A5"/></DataTrigger></Button.Triggers>
              </Button>
            </Grid>
          </VerticalStackLayout>
        </Border>
        <VerticalStackLayout Padding="18,0,18,100" Spacing="12">
          <Border Style="{StaticResource Card}" Margin="0,-20,0,0" Padding="14,18">
            <VerticalStackLayout Spacing="14">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <controls:ChoiceField ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Label" Title="Vista"/>
                <Label Grid.Column="1" Text="Riepilogo per categoria" Style="{StaticResource MutedLabel}" FontSize="12" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                <Button Grid.Column="2" Text="Oggi" Command="{Binding CurrentMonthCommand}" IsVisible="{Binding CanStepPeriod}" Style="{StaticResource TextButton}"/>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsCustomPeriod}">
                <VerticalStackLayout><Label Text="Dal"/><DatePicker Date="{Binding CustomFrom}"/></VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1"><Label Text="Al"/><DatePicker Date="{Binding CustomTo}"/></VerticalStackLayout>
              </Grid>
              <Grid ColumnDefinitions="44,*,44" IsVisible="{Binding CanStepPeriod}">
                <Button Text="‹" Command="{Binding PreviousMonthCommand}" Style="{StaticResource TextButton}" FontSize="30" Padding="0" SemanticProperties.Description="Periodo precedente"/>
                <Label Grid.Column="1" Text="{Binding MonthLabel}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="17" FontAttributes="Bold" TextTransform="None"/>
                <Button Grid.Column="2" Text="›" Command="{Binding NextMonthCommand}" Style="{StaticResource TextButton}" FontSize="30" Padding="0" SemanticProperties.Description="Periodo successivo"/>
              </Grid>
              <controls:CategoryChart/>
              <Label Text="{Binding EmptyChartText}" IsVisible="{Binding HasNoChartData}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
          </Border>
          <Border Style="{StaticResource Card}" Padding="16">
            <Grid ColumnDefinitions="*,Auto">
              <VerticalStackLayout Spacing="3"><Label Text="Differenza del periodo" FontAttributes="Bold"/><Label Text="Entrate − spese" Style="{StaticResource MutedLabel}" FontSize="12"/></VerticalStackLayout>
              <Label Grid.Column="1" TextColor="{StaticResource PrimaryGlow}" FontSize="20" FontAttributes="Bold" VerticalTextAlignment="Center">
                <Label.Text><MultiBinding Converter="{StaticResource MoneyConverter}"><Binding Path="Difference"/><Binding Path="ReportCurrency"/></MultiBinding></Label.Text>
              </Label>
            </Grid>
          </Border>
          <VerticalStackLayout BindableLayout.ItemsSource="{Binding CategoryBreakdown}" Spacing="10">
            <BindableLayout.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Padding="12,14">
                  <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenCategoryCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers>
                  <Grid ColumnDefinitions="42,*,Auto,Auto" ColumnSpacing="10">
                    <Border WidthRequest="42" HeightRequest="42" Padding="10" BackgroundColor="{Binding Color}" StrokeShape="Ellipse"><Image Source="{Binding IconSource}"/></Border>
                    <Label Grid.Column="1" Text="{Binding Name}" FontSize="15" FontAttributes="Bold" VerticalTextAlignment="Center" LineBreakMode="TailTruncation"/>
                    <Label Grid.Column="2" Text="{Binding Percentage}" Style="{StaticResource MutedLabel}" FontSize="13" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="3" FontSize="15" FontAttributes="Bold" VerticalTextAlignment="Center">
                      <Label.Text><MultiBinding Converter="{StaticResource MoneyConverter}"><Binding Path="Total"/><Binding Path="Currency"/></MultiBinding></Label.Text>
                    </Label>
                  </Grid>
                </Border>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>
          <Label Text="{Binding BalanceWarning}" TextColor="{StaticResource Expense}"/>
          <Label Text="{Binding ComparisonText}" Style="{StaticResource MutedLabel}" FontSize="12" Margin="2,4"/>
          <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}"/>
          <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
        </VerticalStackLayout>
      </VerticalStackLayout>
    </ScrollView>
    <Button Style="{StaticResource FloatingActionButton}" Command="{Binding NewTransactionCommand}" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,22,24" SemanticProperties.Description="Aggiungi un movimento"/>
  </Grid>
</ContentPage>
