<?xml version='1.0' encoding='utf-8'?>
<ContentPage Shell.NavBarIsVisible="False" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:ExpenseTracker.Presentation.Controls" x:Class="ExpenseTracker.Presentation.Views.TransactionEditorPage" x:Name="Page" Title="{Binding Title}">
  <ScrollView>
    <VerticalStackLayout Spacing="0">
      <controls:PageHeader Heading="{Binding Title}" Subtitle="Ogni movimento trova il suo posto"/>
      <VerticalStackLayout Padding="18,18,18,32" Spacing="18">

      <controls:ChoiceField ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Label" Title="Entrata o uscita"/>
      <Border Style="{StaticResource HeroCard}" Padding="22">
        <VerticalStackLayout Spacing="8">
          <Label Text="Importo" Style="{StaticResource MutedLabel}"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Entry Placeholder="0,00" Text="{Binding Amount}" Keyboard="Numeric" FontSize="38" FontAttributes="Bold" ClearButtonVisibility="WhileEditing"/>
            <Label Grid.Column="1" Text="{Binding Currency}" TextColor="{StaticResource PrimaryGlow}" VerticalTextAlignment="Center" FontAttributes="Bold"/>
          </Grid>
        </VerticalStackLayout>
      </Border>
      <Label Text="{Binding AmountError}" TextColor="{StaticResource Expense}"/>
      <Grid ColumnDefinitions="*,Auto">
        <Label Text="Categoria" Style="{StaticResource SectionTitle}"/>
        <Label Grid.Column="1" Text="{Binding SelectedCategory.Name, TargetNullValue='Scegli qui sotto'}" TextColor="{StaticResource PrimaryGlow}" VerticalTextAlignment="Center"/>
      </Grid>
      <ScrollView Orientation="Horizontal">
        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding QuickCategories}">
          <BindableLayout.ItemTemplate>
            <DataTemplate>
              <Border Padding="10" Margin="0,0,8,8" WidthRequest="98" HeightRequest="92" BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 22" StrokeThickness="2">
                <Border.Stroke>
                  <MultiBinding Converter="{StaticResource SelectionOutline}">
                    <Binding Path="."/>
                    <Binding Source="{x:Reference Page}" Path="BindingContext.SelectedCategory"/>
                  </MultiBinding>
                </Border.Stroke>
                <VerticalStackLayout Spacing="6">
                  <Border WidthRequest="36" HeightRequest="36" Padding="8" BackgroundColor="{Binding Color}" StrokeShape="RoundRectangle 12">
                    <Image Source="{Binding IconSource}"/>
                  </Border>
                  <Label Text="{Binding Name}" FontSize="11" HorizontalTextAlignment="Center" MaxLines="2" LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.ChooseCategoryCommand}" CommandParameter="{Binding .}"/>
                </Border.GestureRecognizers>
              </Border>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>
      </ScrollView>
      <controls:ChoiceField ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Title="Tutte le categorie"/>
      <Label Text="{Binding CategoryError}" TextColor="{StaticResource Expense}"/>
      <Button Text="Aggiungi / rimuovi categoria dai preferiti" Command="{Binding ToggleFavoriteCommand}" Style="{StaticResource TextButton}"/>
      <controls:ChoiceField ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="DisplayName" Title="Scegli un conto"/>
      <Label Text="{Binding AccountError}" TextColor="{StaticResource Expense}"/>
      <HorizontalStackLayout><Switch IsToggled="{Binding RememberAccount}"/><Label Text="Ricorda l'ultimo conto" VerticalTextAlignment="Center"/></HorizontalStackLayout>
      <Label Text="{Binding StatusMessage}" TextColor="{StaticResource PrimaryGlow}"/>
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}"/>
      <Button Text="Salva movimento" Command="{Binding SaveCommand}" FontSize="16"/>
      <Button Text="Salva e aggiungi un'altra" Command="{Binding SaveAndAddCommand}" Style="{StaticResource SecondaryButton}"/>
      <Button Text="Scarta bozza" Command="{Binding DiscardDraftCommand}" Style="{StaticResource TextButton}"/>
      <Button Text="Data, descrizione e altri dettagli ⌄" Style="{StaticResource TextButton}" Command="{Binding ToggleDetailsCommand}"/>
      <Border Style="{StaticResource Card}" IsVisible="{Binding ShowDetails}">
        <VerticalStackLayout Spacing="12">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Border Style="{StaticResource InputCard}">
              <DatePicker Date="{Binding Date}"/>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource InputCard}">
              <TimePicker Time="{Binding Time}"/>
            </Border>
          </Grid>
          <Border Style="{StaticResource InputCard}">
            <Entry Placeholder="Descrizione (facoltativa)" Text="{Binding Description}"/>
          </Border>
          <Border Style="{StaticResource InputCard}">
            <Editor Placeholder="Note (facoltative)" Text="{Binding Notes}" AutoSize="TextChanges"/>
          </Border>
          <Grid ColumnDefinitions="*,Auto">
            <Label Text="Valuta" VerticalTextAlignment="Center"/>
            <Border Grid.Column="1" Style="{StaticResource InputCard}">
              <Label Text="{Binding Currency}" WidthRequest="70"/>
            </Border>
          </Grid>
        </VerticalStackLayout>
      </Border>
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
    </VerticalStackLayout>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
