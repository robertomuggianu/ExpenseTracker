<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Presentation.Views.TransactionEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="{Binding Title}" Style="{StaticResource Headline}" HorizontalOptions="Start" />
            <Label Text="Tipo" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding Types}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedType}" />

            <Label Text="Conto" FontAttributes="Bold" />
            <Picker Title="Seleziona il conto"
                    ItemsSource="{Binding Accounts}"
                    ItemDisplayBinding="{Binding DisplayName}"
                    SelectedItem="{Binding SelectedAccount}" />

            <Label Text="Macro-categoria" FontAttributes="Bold" />
            <Picker Title="Seleziona la macro-categoria"
                    ItemsSource="{Binding MacroCategories}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedMacroCategory}" />

            <Label Text="Categoria" FontAttributes="Bold" />
            <Picker Title="Seleziona la categoria"
                    ItemsSource="{Binding Categories}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedCategory}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <VerticalStackLayout>
                    <Label Text="Data" FontAttributes="Bold" />
                    <DatePicker Date="{Binding Date}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Ora" FontAttributes="Bold" />
                    <TimePicker Time="{Binding Time}" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="Importo" FontAttributes="Bold" />
            <Entry Placeholder="0,00" Text="{Binding Amount}" Keyboard="Numeric" />
            <Label Text="Valuta" FontAttributes="Bold" />
            <Entry Text="{Binding Currency}" MaxLength="3" />
            <Label Text="Descrizione" FontAttributes="Bold" />
            <Entry Placeholder="Opzionale" Text="{Binding Description}" />
            <Label Text="Note" FontAttributes="Bold" />
            <Editor Placeholder="Opzionali" Text="{Binding Notes}" AutoSize="TextChanges" />

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}" />
            <Button Text="Salva movimento" Command="{Binding SaveCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
