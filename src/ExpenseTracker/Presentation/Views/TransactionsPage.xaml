<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Presentation.Views.TransactionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ExpenseTracker.Presentation.Controls"
    x:Name="Page"
    Title="Movimenti">
    <Grid RowDefinitions="Auto,Auto,*">
        <controls:PageHeader Heading="Movimenti" Subtitle="Tutte le tue entrate e le tue spese"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,12,16,10" Padding="12">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <Button Text="Filtri ⌄" Style="{StaticResource TextButton}" Command="{Binding ToggleFiltersCommand}" HorizontalOptions="Start" />
                    <Button Grid.Column="1" Text="Applica" Command="{Binding ApplyFiltersCommand}" Padding="16,8" MinimumHeightRequest="40" />
                </Grid>
                <Grid IsVisible="{Binding FiltersVisible}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <controls:ChoiceField ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Label" Title="Periodo" />
                    <controls:ChoiceField Grid.Column="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="Name" Title="Conto" />
                    <controls:ChoiceField Grid.Row="1" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Label" Title="Tipo" />
                    <controls:ChoiceField Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Title="Categoria" />
                </Grid>
                <Grid IsVisible="{Binding IsCustomPeriod}" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Style="{StaticResource InputCard}"><DatePicker Date="{Binding CustomFrom}" /></Border>
                    <Border Grid.Column="1" Style="{StaticResource InputCard}"><DatePicker Date="{Binding CustomTo}" /></Border>
                </Grid>
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}" FontSize="12" />
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="*,Auto" Margin="16,0,16,76" RowSpacing="8">
            <CollectionView ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None">
                <CollectionView.GroupHeaderTemplate><DataTemplate><Label Text="{Binding Title}" Style="{StaticResource MutedLabel}" Margin="4,8,0,12" FontAttributes="Bold" /></DataTemplate></CollectionView.GroupHeaderTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="◎" TextColor="{StaticResource PrimaryGlow}" FontSize="42" HorizontalTextAlignment="Center" />
                        <Label Text="Nessun movimento" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Prova a cambiare i filtri oppure aggiungi la prima operazione." Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="44,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                    <Border Grid.RowSpan="2" WidthRequest="44" HeightRequest="44" Padding="0" StrokeThickness="0" BackgroundColor="{Binding CategoryColor}" StrokeShape="RoundRectangle 14">
                                        <Image Source="{Binding IconSource}" WidthRequest="24" HeightRequest="24" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding DisplayDescription}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="2" FontSize="17" FontAttributes="Bold" >
                        <Label.Text>
                            <MultiBinding Converter="{StaticResource MoneyConverter}">
                                <Binding Path="SignedAmount" />
                                <Binding Path="Transaction.Currency" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding AccountName}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    <Label Grid.Row="1" Grid.Column="2" Text="{Binding LocalDate, StringFormat='{0:dd MMM yyyy}'}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                </Grid>
                                <FlexLayout Direction="Row" Wrap="Wrap">
                                    <Button Text="Dettaglio" Style="{StaticResource TextButton}" Margin="0,0,4,0" Command="{Binding Source={x:Reference Page}, Path=BindingContext.ShowDetailCommand}" CommandParameter="{Binding .}" />
                                    <Button Text="Modifica" Style="{StaticResource TextButton}" Margin="0,0,4,0" Command="{Binding Source={x:Reference Page}, Path=BindingContext.EditCommand}" CommandParameter="{Binding .}" />
                                    <Button Text="Elimina" Style="{StaticResource DangerButton}" Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}" />
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" IsVisible="{Binding HasSelectedTransaction}" Stroke="{StaticResource Primary}">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                    <Label Text="Dettaglio movimento" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding SelectedTransaction.TypeLabel}" TextColor="{StaticResource PrimaryGlow}" FontAttributes="Bold" />
                    <Label Grid.Row="1" Text="{Binding SelectedTransaction.AccountName, StringFormat='Conto · {0}'}" Style="{StaticResource MutedLabel}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTransaction.CategoryName}" Style="{StaticResource MutedLabel}" />
                    <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SelectedTransaction.Transaction.Notes, TargetNullValue='Nessuna nota'}" FontSize="12" />
                </Grid>
            </Border>
            <ActivityIndicator Grid.RowSpan="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
        </Grid>

        <Button Grid.RowSpan="3" Style="{StaticResource FloatingActionButton}" Command="{Binding NewTransactionCommand}"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,22,24"
                SemanticProperties.Description="Aggiungi un nuovo movimento" />
    </Grid>
</ContentPage>
