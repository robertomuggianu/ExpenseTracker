<?xml version="1.0" encoding="utf-8" ?>
<ContentPage Shell.NavBarIsVisible="False"
    x:Class="ExpenseTracker.Presentation.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ExpenseTracker.Presentation.Controls"
    x:Name="Page"
    Title="Conti">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="0">
                <controls:PageHeader Heading="Conti"/>
                <VerticalStackLayout Spacing="6" Padding="20,30,20,22">
                    <Label Text="Saldo totale" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" FontSize="16"/>
                    <Label Style="{StaticResource HeroValue}" HorizontalTextAlignment="Center">
                        <Label.Text><MultiBinding Converter="{StaticResource MoneyConverter}"><Binding Path="TotalBalance"/><Binding Path="BalanceCurrency"/></MultiBinding></Label.Text>
                    </Label>
                </VerticalStackLayout>

                <VerticalStackLayout Padding="16,14,16,100" Spacing="12">


                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsEditorVisible}" Stroke="{StaticResource Primary}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border WidthRequest="42" HeightRequest="42" Padding="0" BackgroundColor="{StaticResource PrimaryDark}" StrokeThickness="0" StrokeShape="RoundRectangle 13">
                                    <Label Text="¤" TextColor="{StaticResource PrimaryGlow}" FontSize="23" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="Dati del conto" FontSize="19" FontAttributes="Bold" />
                                    <Label Text="Le modifiche non alterano lo storico" Style="{StaticResource MutedLabel}" FontSize="12" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="Nome" FontAttributes="Bold" FontSize="12" />
                            <Border Style="{StaticResource InputCard}"><Entry Placeholder="Es. Conto principale" Text="{Binding Name}" /></Border>
                            <Grid ColumnDefinitions="2*,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Saldo iniziale" FontAttributes="Bold" FontSize="12" />
                                    <Border Style="{StaticResource InputCard}"><Entry Placeholder="0,00" Text="{Binding OpeningBalance}" Keyboard="Numeric" /></Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="5">
                                    <Label Text="Valuta" FontAttributes="Bold" FontSize="12" />
                                    <Border Style="{StaticResource InputCard}"><Entry Text="{Binding Currency}" MaxLength="3" /></Border>
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,*">
                                <HorizontalStackLayout><CheckBox IsChecked="{Binding IsPrimary}" /><Label Text="Principale" VerticalTextAlignment="Center" /></HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="1"><CheckBox IsChecked="{Binding IsActive}" /><Label Text="Attivo" VerticalTextAlignment="Center" /></HorizontalStackLayout>
                            </Grid>
                            <Button Text="Salva conto" Command="{Binding SaveCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Accounts}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="50,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                            <Border Grid.RowSpan="2" WidthRequest="50" HeightRequest="50" Padding="0" BackgroundColor="{StaticResource PrimaryDark}" StrokeThickness="0" StrokeShape="Ellipse">
                                                <Image Source="category_wallet.png" WidthRequest="27" HeightRequest="27"/>
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding DisplayName}" FontSize="18" FontAttributes="Bold" />
                                            <Label Grid.Column="2" FontSize="19" FontAttributes="Bold" >
                        <Label.Text>
                            <MultiBinding Converter="{StaticResource MoneyConverter}">
                                <Binding Path="CurrentBalance" />
                                <Binding Path="Account.Currency" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Account.Currency, StringFormat='Valuta {0}'}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                            <Label Grid.Row="1" Grid.Column="2" Text="Non attivo" TextColor="{StaticResource Expense}" FontSize="12" IsVisible="{Binding IsInactive}" />
                                        </Grid>
                                        <Label Text="{Binding BalanceWarning}" TextColor="{StaticResource Expense}" IsVisible="{Binding HasCurrencyMismatch}"/>
                                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" />
                                        <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start">
                                            <Button Text="Modifica" Style="{StaticResource TextButton}" Margin="0,0,6,0"
                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.EditCommand}" CommandParameter="{Binding .}" />
                                            <Button Text="Rendi principale" Style="{StaticResource TextButton}" Margin="0,0,6,0"
                                                    IsEnabled="{Binding Account.IsActive}" Command="{Binding Source={x:Reference Page}, Path=BindingContext.SetPrimaryCommand}" CommandParameter="{Binding .}" />
                                            <Button Text="Attiva / disattiva" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleActiveCommand}" CommandParameter="{Binding .}" />
                                        </FlexLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Button Style="{StaticResource FloatingActionButton}" Command="{Binding NewAccountCommand}"
                HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,24"
                SemanticProperties.Description="Aggiungi un nuovo conto" />
    </Grid>
</ContentPage>
