<?xml version='1.0' encoding='utf-8'?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:ExpenseTracker.Presentation.Controls" x:Class="ExpenseTracker.Presentation.Views.CategoriesPage" x:Name="Page" Title="Categorie">
  <ScrollView>
    <VerticalStackLayout Padding="20,22,20,32" Spacing="18">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Button Text="‹" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}"/>
        <Label Grid.Column="1" Text="Categorie" Style="{StaticResource PageTitle}" VerticalTextAlignment="Center"/>
        <Button Grid.Column="2" Text="＋" Command="{Binding NewCategoryCommand}" SemanticProperties.Description="Nuova categoria"/>
      </Grid>
      <Label Text="Un'icona e un colore per riconoscere ogni spesa." Style="{StaticResource MutedLabel}"/>
      <Border Style="{StaticResource Card}" IsVisible="{Binding IsEditorVisible}">
        <VerticalStackLayout Spacing="14">
          <Grid ColumnDefinitions="56,*" ColumnSpacing="14">
            <Border WidthRequest="56" HeightRequest="56" BackgroundColor="{Binding CategoryColor}" Padding="14" StrokeShape="RoundRectangle 20">
              <Image Source="{Binding SelectedIcon.ImageSource}"/>
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
              <Label Text="{Binding CategoryName}" FontSize="20" FontAttributes="Bold"/>
              <Label Text="{Binding SelectedIcon.Label}" Style="{StaticResource MutedLabel}"/>
            </VerticalStackLayout>
          </Grid>
          <Border Style="{StaticResource InputCard}">
            <Entry Placeholder="Nome categoria" Text="{Binding CategoryName}"/>
          </Border>
          <controls:ChoiceField ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedCategoryType}" DisplayMemberPath="Label" Title="Tipo"/>
          <Label Text="Scegli un'icona" FontAttributes="Bold"/>
          <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Icons}">
            <BindableLayout.ItemTemplate>
              <DataTemplate>
                <Border BackgroundColor="{StaticResource DarkSurfaceAlt}" Padding="10" Margin="0,0,8,8" WidthRequest="60" HeightRequest="60" StrokeShape="RoundRectangle 18" StrokeThickness="2">
                  <Border.Stroke>
                    <MultiBinding Converter="{StaticResource SelectionOutline}">
                      <Binding Path="."/>
                      <Binding Source="{x:Reference Page}" Path="BindingContext.SelectedIcon"/>
                    </MultiBinding>
                  </Border.Stroke>
                  <Image Source="{Binding ImageSource}" WidthRequest="28" HeightRequest="28" SemanticProperties.Description="{Binding Label}"/>
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectIconCommand}" CommandParameter="{Binding .}"/>
                  </Border.GestureRecognizers>
                </Border>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </FlexLayout>
          <Label Text="Scegli un colore" FontAttributes="Bold"/>
          <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Palette}">
            <BindableLayout.ItemTemplate>
              <DataTemplate>
                <Border BackgroundColor="{Binding .}" WidthRequest="44" HeightRequest="44" Margin="0,0,8,8" StrokeShape="RoundRectangle 22" SemanticProperties.Description="{Binding .}" StrokeThickness="3">
                  <Border.Stroke>
                    <MultiBinding Converter="{StaticResource SelectionOutline}" ConverterParameter="#FFFFFF">
                      <Binding Path="."/>
                      <Binding Source="{x:Reference Page}" Path="BindingContext.CategoryColor"/>
                    </MultiBinding>
                  </Border.Stroke>
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectColorCommand}" CommandParameter="{Binding .}"/>
                  </Border.GestureRecognizers>
                </Border>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </FlexLayout>
          <HorizontalStackLayout>
            <CheckBox IsChecked="{Binding CategoryIsActive}"/>
            <Label Text="Categoria attiva" VerticalTextAlignment="Center"/>
          </HorizontalStackLayout>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Text="Annulla" Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditCommand}"/>
            <Button Grid.Column="1" Text="Salva" Command="{Binding SaveCategoryCommand}"/>
          </Grid>
        </VerticalStackLayout>
      </Border>
      <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}" Spacing="10">
        <BindableLayout.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="14">
              <Grid ColumnDefinitions="48,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                <Border Grid.RowSpan="2" WidthRequest="48" HeightRequest="48" BackgroundColor="{Binding Color}" Padding="12" StrokeShape="RoundRectangle 17">
                  <Image Source="{Binding IconSource}"/>
                </Border>
                <Label Grid.Column="1" Text="{Binding Name}" FontSize="17" FontAttributes="Bold"/>
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding TypeLabel}" Style="{StaticResource MutedLabel}" FontSize="12"/>
                <Button Grid.Column="2" Grid.RowSpan="2" Text="Modifica" Style="{StaticResource TextButton}" Command="{Binding Source={x:Reference Page}, Path=BindingContext.EditCategoryCommand}" CommandParameter="{Binding .}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </VerticalStackLayout>
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}"/>
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
