<?xml version='1.0' encoding='utf-8'?>
<ContentPage Shell.NavBarIsVisible="False" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:ExpenseTracker.Presentation.Controls" x:Class="ExpenseTracker.Presentation.Views.CategoriesPage" x:Name="Page" Title="Categorie">
  <ScrollView x:Name="CategoryScroll">
    <VerticalStackLayout Spacing="0">
      <Border Style="{StaticResource HeaderCard}">
        <VerticalStackLayout Spacing="20">
          <Grid ColumnDefinitions="46,*,46">
            <Button Style="{StaticResource HeaderMenuButton}" Command="{Binding OpenMenuCommand}" SemanticProperties.Description="Apri menu"/>
            <Label Grid.Column="1" Text="Categorie" FontSize="23" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
            <Image Grid.Column="2" Source="brand_mark.png" WidthRequest="46" HeightRequest="46"/>
          </Grid>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <VerticalStackLayout Spacing="2">
              <Button Text="SPESE" Style="{StaticResource ReportTab}" Command="{Binding SelectExpensesCommand}">
                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsExpenseSelected}" Value="True"><Setter Property="TextColor" Value="{StaticResource DarkText}"/></DataTrigger></Button.Triggers>
              </Button>
              <BoxView HeightRequest="3" Color="{StaticResource PrimaryGlow}" Margin="22,0" IsVisible="{Binding IsExpenseSelected}"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
              <Button Text="ENTRATE" Style="{StaticResource ReportTab}" Command="{Binding SelectIncomeCommand}">
                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsIncomeSelected}" Value="True"><Setter Property="TextColor" Value="{StaticResource DarkText}"/></DataTrigger></Button.Triggers>
              </Button>
              <BoxView HeightRequest="3" Color="{StaticResource PrimaryGlow}" Margin="22,0" IsVisible="{Binding IsIncomeSelected}"/>
            </VerticalStackLayout>
          </Grid>
        </VerticalStackLayout>
      </Border>
      <VerticalStackLayout Padding="18,18,18,100" Spacing="18">
      <controls:SearchField Placeholder="Cerca una categoria" Text="{Binding SearchText}"/>
      <Border x:Name="CategoryEditor" Style="{StaticResource Card}" IsVisible="{Binding IsEditorVisible}">
        <VerticalStackLayout Spacing="14">
          <Grid ColumnDefinitions="56,*" ColumnSpacing="14">
            <Border WidthRequest="56" HeightRequest="56" BackgroundColor="{Binding CategoryColor}" Padding="14" StrokeShape="RoundRectangle 20">
              <Image Source="{Binding SelectedIcon.ImageSource}"/>
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
              <Label Text="{Binding CategoryName}" FontSize="20" FontAttributes="Bold"/>
              <Label Text="{Binding SelectedIcon.Label}" Style="{StaticResource MutedLabel}"/>
            </VerticalStackLayout>
          </Grid>
          <Border Style="{StaticResource InputCard}">
            <Entry Placeholder="Nome categoria" Text="{Binding CategoryName}"/>
          </Border>
          <controls:TransactionTypeField SelectedItem="{Binding SelectedCategoryType}"/>
          <Label Text="Scegli un'icona" FontAttributes="Bold"/>
          <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Icons}">
            <BindableLayout.ItemTemplate>
              <DataTemplate>
                <Border BackgroundColor="{StaticResource DarkSurfaceAlt}" Padding="10" Margin="0,0,8,8" WidthRequest="60" HeightRequest="60" StrokeShape="RoundRectangle 18" StrokeThickness="2">
                  <Border.Stroke>
                    <MultiBinding Converter="{StaticResource SelectionOutline}">
                      <Binding Path="."/>
                      <Binding Source="{x:Reference Page}" Path="BindingContext.SelectedIcon"/>
                    </MultiBinding>
                  </Border.Stroke>
                  <Image Source="{Binding ImageSource}" WidthRequest="28" HeightRequest="28" SemanticProperties.Description="{Binding Label}"/>
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectIconCommand}" CommandParameter="{Binding .}"/>
                  </Border.GestureRecognizers>
                </Border>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </FlexLayout>
          <Label Text="Scegli un colore" FontAttributes="Bold"/>
          <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Palette}">
            <BindableLayout.ItemTemplate>
              <DataTemplate>
                <Border BackgroundColor="{Binding .}" WidthRequest="44" HeightRequest="44" Margin="0,0,8,8" StrokeShape="RoundRectangle 22" SemanticProperties.Description="{Binding .}" StrokeThickness="3">
                  <Border.Stroke>
                    <MultiBinding Converter="{StaticResource SelectionOutline}" ConverterParameter="#FFFFFF">
                      <Binding Path="."/>
                      <Binding Source="{x:Reference Page}" Path="BindingContext.CategoryColor"/>
                    </MultiBinding>
                  </Border.Stroke>
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectColorCommand}" CommandParameter="{Binding .}"/>
                  </Border.GestureRecognizers>
                </Border>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </FlexLayout>
          <HorizontalStackLayout>
            <CheckBox IsChecked="{Binding CategoryIsActive}"/>
            <Label Text="Categoria attiva" VerticalTextAlignment="Center"/>
          </HorizontalStackLayout>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Text="Annulla" Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditCommand}"/>
            <Button Grid.Column="1" Text="Salva" Command="{Binding SaveCategoryCommand}"/>
          </Grid>
        </VerticalStackLayout>
      </Border>
      <FlexLayout Wrap="Wrap" AlignItems="Start" BindableLayout.ItemsSource="{Binding CategoryTiles}" MaximumWidthRequest="640" HorizontalOptions="Fill">
        <BindableLayout.ItemTemplate>
          <DataTemplate>
            <Grid FlexLayout.Basis="25%" ColumnDefinitions="*" RowDefinitions="Auto,Auto" Padding="3,8" RowSpacing="7" MinimumHeightRequest="118" Opacity="{Binding Opacity}" SizeChanged="OnCategoryTileSizeChanged"
                                 SemanticProperties.Description="{Binding AccessibilityDescription}" SemanticProperties.Hint="{Binding AccessibilityHint}" ToolTipProperties.Text="{Binding Name}">
              <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoryTileTapped" CommandParameter="{Binding .}"/></Grid.GestureRecognizers>
              <Border BackgroundColor="{Binding Color}" WidthRequest="64" HeightRequest="64" HorizontalOptions="Center" Padding="12" StrokeThickness="0" StrokeShape="Ellipse">
                <Grid InputTransparent="True">
                  <Image Source="{Binding IconSource}" IsVisible="{Binding IsCategory}"/>
                  <Label Text="+" IsVisible="{Binding IsCreate}" TextColor="{StaticResource DarkBackground}" FontSize="42" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Grid>
              </Border>
              <Label Grid.Row="1" Text="{Binding Name}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Fill" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="4"/>
            </Grid>
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </FlexLayout>
      <Label Text="Nessuna categoria trovata" IsVisible="{Binding HasNoCategories}" Style="{StaticResource MutedLabel}"/>
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}"/>
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
    </VerticalStackLayout>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
