<?xml version='1.0' encoding='utf-8'?>
<ContentPage Shell.NavBarIsVisible="False" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:ExpenseTracker.Presentation.Controls" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui" x:Class="ExpenseTracker.Presentation.Views.StatisticsPage" x:Name="Page" Title="Statistiche">
  <ScrollView>
    <VerticalStackLayout Spacing="0">
      <controls:PageHeader Heading="Statistiche"/>
      <VerticalStackLayout Padding="16,14,16,100" Spacing="12">
        <Border Style="{StaticResource Card}" Padding="14">
          <VerticalStackLayout Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <Label Text="Intervallo di analisi" FontSize="17" FontAttributes="Bold" VerticalTextAlignment="Center"/>
              <Button Grid.Column="1" Text="Aggiorna" Command="{Binding ApplyFiltersCommand}" Padding="16,8" MinimumHeightRequest="40"/>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <controls:ChoiceField ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Label" Title="Periodo"/>
              <controls:ChoiceField Grid.Column="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="Name" Title="Conto"/>
            </Grid>
            <controls:ChoiceField Title="Valuta del report" ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}"/>
            <DatePicker IsVisible="{Binding IsReferencePeriod}" Date="{Binding ReferenceDate}"/>
            <Grid IsVisible="{Binding IsCustomPeriod}" ColumnDefinitions="*,*" ColumnSpacing="8">
              <Border Style="{StaticResource InputCard}">
                <DatePicker Date="{Binding CustomFrom}"/>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource InputCard}">
                <DatePicker Date="{Binding CustomTo}"/>
              </Border>
            </Grid>
          </VerticalStackLayout>
        </Border>
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
          <Border Style="{StaticResource Card}" Stroke="#4036C88A">
            <VerticalStackLayout>
              <Label Text="ENTRATE" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Income}"/>
              <Label Style="{StaticResource MetricValue}" TextColor="{StaticResource Income}" FontSize="22">
                <Label.Text>
                  <MultiBinding Converter="{StaticResource MoneyConverter}">
                    <Binding Path="Income"/>
                    <Binding Path="ReportCurrency"/>
                  </MultiBinding>
                </Label.Text>
              </Label>
            </VerticalStackLayout>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Stroke="#40FF5960">
            <VerticalStackLayout>
              <Label Text="USCITE" Style="{StaticResource Eyebrow}"/>
              <Label Style="{StaticResource MetricValue}" TextColor="{StaticResource Warning}" FontSize="22">
                <Label.Text>
                  <MultiBinding Converter="{StaticResource MoneyConverter}">
                    <Binding Path="Expense"/>
                    <Binding Path="ReportCurrency"/>
                  </MultiBinding>
                </Label.Text>
              </Label>
            </VerticalStackLayout>
          </Border>
          <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}">
            <Grid ColumnDefinitions="*,Auto">
              <VerticalStackLayout>
                <Label Text="RISULTATO" Style="{StaticResource Eyebrow}"/>
                <Label Text="Differenza nel periodo" Style="{StaticResource MutedLabel}" FontSize="12"/>
              </VerticalStackLayout>
              <Label Grid.Column="1" Style="{StaticResource MetricValue}" VerticalTextAlignment="Center">
                <Label.Text>
                  <MultiBinding Converter="{StaticResource MoneyConverter}">
                    <Binding Path="Difference"/>
                    <Binding Path="ReportCurrency"/>
                  </MultiBinding>
                </Label.Text>
              </Label>
            </Grid>
          </Border>
        </Grid>
        <Label Text="Andamento temporale" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource Card}" Padding="10,16">
          <lvc:CartesianChart BackgroundColor="{StaticResource DarkSurface}" Series="{Binding TrendSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" HeightRequest="310" LegendPosition="Bottom"/>
        </Border>
        <Label Text="Distribuzione uscite" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource Card}" Padding="10,16">
          <VerticalStackLayout Spacing="14">
              <controls:CategoryChart PointCommand="{Binding OpenChartCommand}"/>
            <Label Text="Nessuna spesa in questo periodo" IsVisible="{Binding HasNoChartData}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center"/>
          </VerticalStackLayout>
        </Border>
          <VerticalStackLayout BindableLayout.ItemsSource="{Binding CategoryBreakdown}" Spacing="10">
            <BindableLayout.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Padding="12,14">
                  <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenCategoryCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers>
                  <Grid ColumnDefinitions="42,*,Auto,Auto" ColumnSpacing="10">
                    <Border WidthRequest="42" HeightRequest="42" Padding="10" BackgroundColor="{Binding Color}" StrokeShape="Ellipse"><Image Source="{Binding IconSource}"/></Border>
                    <Label Grid.Column="1" Text="{Binding Name}" FontSize="15" FontAttributes="Bold" VerticalTextAlignment="Center" LineBreakMode="TailTruncation"/>
                    <Label Grid.Column="2" Text="{Binding Percentage}" Style="{StaticResource MutedLabel}" FontSize="13" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="3" FontSize="15" FontAttributes="Bold" VerticalTextAlignment="Center">
                      <Label.Text><MultiBinding Converter="{StaticResource MoneyConverter}"><Binding Path="Total"/><Binding Path="Currency"/></MultiBinding></Label.Text>
                    </Label>
                  </Grid>
                </Border>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>
        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}"/>
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
      </VerticalStackLayout>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
