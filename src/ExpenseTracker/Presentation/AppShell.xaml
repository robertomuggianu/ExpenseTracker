<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ExpenseTracker.Presentation.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="ExpenseTracker"
    FlyoutBehavior="Flyout"
    FlyoutHeaderBehavior="Fixed"
    FlyoutWidth="310"
    Shell.NavBarIsVisible="False"
    Shell.BackgroundColor="#101216"
    Shell.ForegroundColor="#FFFFFF"
    Shell.TitleColor="#FFFFFF"
    Shell.UnselectedColor="#B9BDC4"
    Shell.FlyoutBackgroundColor="#17191E">

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid x:Name="FlyoutRow" Padding="22,14" Margin="10,3" ColumnDefinitions="5,*" ColumnSpacing="14">
                <Border x:Name="SelectionMark" WidthRequest="5" StrokeThickness="0" BackgroundColor="Transparent" StrokeShape="RoundRectangle 3" />
                <Label x:Name="FlyoutLabel" Grid.Column="1" Text="{Binding Title}" TextColor="#F7F7F8"
                       FontSize="16" FontAttributes="Bold" VerticalTextAlignment="Center" />
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter TargetName="FlyoutRow" Property="BackgroundColor" Value="#2A2E35" />
                                <Setter TargetName="FlyoutLabel" Property="Label.TextColor" Value="#FF6B70" />
                                <Setter TargetName="SelectionMark" Property="Border.BackgroundColor" Value="#E2383F" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.FlyoutHeader>
        <Grid BackgroundColor="#B51F2A" Padding="22,20,22,18" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
            <Border WidthRequest="44" HeightRequest="44" Padding="0" HorizontalOptions="Start"
                    BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                <Label Text="ET" TextColor="#B51F2A" FontSize="17" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Border>
            <Label Grid.Row="1" Text="ExpenseTracker" TextColor="White" FontSize="22" FontAttributes="Bold" />
            <Label Grid.Row="2" Text="Le tue finanze, senza distrazioni." TextColor="#FFD7D9" FontSize="13" />
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Panoramica" Route="Dashboard">
        <ShellContent x:Name="DashboardContent" Title="Panoramica" />
    </FlyoutItem>
    <FlyoutItem Title="Movimenti" Route="Transactions">
        <ShellContent x:Name="TransactionsContent" Title="Movimenti" />
    </FlyoutItem>
    <FlyoutItem Title="Nuovo movimento" Route="NewTransaction">
        <ShellContent x:Name="NewTransactionContent" Title="Nuovo movimento" />
    </FlyoutItem>
    <FlyoutItem Title="Statistiche" Route="Statistics">
        <ShellContent x:Name="StatisticsContent" Title="Statistiche" />
    </FlyoutItem>
    <FlyoutItem Title="Conti" Route="Accounts">
        <ShellContent x:Name="AccountsContent" Title="Conti" />
    </FlyoutItem>
    <FlyoutItem Title="Categorie" Route="Categories">
        <ShellContent x:Name="CategoriesContent" Title="Categorie" />
    </FlyoutItem>
    <FlyoutItem Title="Esportazione CSV" Route="Export">
        <ShellContent x:Name="ExportContent" Title="Esportazione CSV" />
    </FlyoutItem>
</Shell>
