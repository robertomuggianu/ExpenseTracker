<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:ExpenseTracker.Presentation.Services"
             x:Class="ExpenseTracker.Presentation.App">
    <Application.Resources>
        <ResourceDictionary>
            <services:MoneyConverter x:Key="MoneyConverter" />
            <services:SelectionOutlineConverter x:Key="SelectionOutline" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="../Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
