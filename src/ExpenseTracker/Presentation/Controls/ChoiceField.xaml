<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ExpenseTracker.Presentation.Controls.ChoiceField"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">
    <Border BackgroundColor="{DynamicResource SurfaceAltColor}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="0">
        <Grid MinimumHeightRequest="50">
            <Button BackgroundColor="Transparent" BorderWidth="0" CornerRadius="16" Padding="0"
                    Clicked="OnClicked" SemanticProperties.Description="{Binding AccessibilityLabel, Source={x:Reference Root}}"
                    SemanticProperties.Hint="Apre l'elenco delle opzioni" />
            <Label Text="{Binding SelectedLabel, Source={x:Reference Root}}"
                   Padding="16,12" FontAttributes="Bold" VerticalTextAlignment="Center"
                   LineBreakMode="TailTruncation" InputTransparent="True" />
        </Grid>
    </Border>
</ContentView>
