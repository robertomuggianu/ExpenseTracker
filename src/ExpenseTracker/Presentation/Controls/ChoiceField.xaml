<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ExpenseTracker.Presentation.Controls.ChoiceField"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">
    <Border Style="{StaticResource InputCard}" Padding="14,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" MinimumHeightRequest="48">
            <Label Text="{Binding SelectedLabel, Source={x:Reference Root}}"
                   VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
            <Label Grid.Column="1" Text="⌄" TextColor="{StaticResource PrimaryGlow}"
                   FontSize="20" VerticalTextAlignment="Center" />
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTapped" />
            </Grid.GestureRecognizers>
        </Grid>
    </Border>
</ContentView>
