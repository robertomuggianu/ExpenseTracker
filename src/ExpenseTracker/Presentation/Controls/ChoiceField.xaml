<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ExpenseTracker.Presentation.Controls.ChoiceField"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">
    <Border Style="{StaticResource InputCard}" Padding="14,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" MinimumHeightRequest="50">
            <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                    Clicked="OnClicked" SemanticProperties.Description="{Binding AccessibilityLabel, Source={x:Reference Root}}"
                    SemanticProperties.Hint="Apre l'elenco delle opzioni" />
            <Label Text="{Binding SelectedLabel, Source={x:Reference Root}}"
                   VerticalTextAlignment="Center" LineBreakMode="TailTruncation" InputTransparent="True" />
            <Border Grid.Column="1" WidthRequest="28" HeightRequest="28" Padding="0"
                    VerticalOptions="Center" BackgroundColor="{StaticResource PrimaryDark}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 9" InputTransparent="True">
                <Path Data="M 2,3 L 7,8 L 12,3" Stroke="{StaticResource PrimaryGlow}"
                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round"
                      HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="14" HeightRequest="11" />
            </Border>
        </Grid>
    </Border>
</ContentView>
