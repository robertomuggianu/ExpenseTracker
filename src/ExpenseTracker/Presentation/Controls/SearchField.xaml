<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpenseTracker.Presentation.Controls.SearchField" x:Name="Search">
  <Border Style="{StaticResource InputCard}" Padding="12,0">
    <Grid ColumnDefinitions="24,*,40" ColumnSpacing="8" MinimumHeightRequest="50">
      <Image Source="ui_search.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
      <Entry x:Name="SearchEntry" Grid.Column="1" Text="{Binding Text, Source={x:Reference Search}, Mode=TwoWay}"
             Placeholder="{Binding Placeholder, Source={x:Reference Search}}" TextChanged="OnTextChanged"
             ClearButtonVisibility="Never" ReturnType="Search" BackgroundColor="Transparent"/>
      <Button Grid.Column="2" Text="×" Style="{StaticResource TextButton}" FontSize="22" Padding="0"
              IsVisible="{Binding HasText, Source={x:Reference Search}}" Clicked="OnClear" SemanticProperties.Description="Cancella ricerca"/>
    </Grid>
  </Border>
</ContentView>
