<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Presentation.Controls.ChoiceSelectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ExpenseTracker.Presentation.Controls"
    x:DataType="controls:ChoiceSelectionPage+ChoiceSelectionModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#B0000000">
    <Grid Padding="14" SizeChanged="OnViewportSizeChanged">
        <Border x:Name="ChoiceSheet" VerticalOptions="End" Padding="20,18,20,20"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderColor}"
                StrokeShape="RoundRectangle 26">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12" MaximumHeightRequest="620">
                <Border WidthRequest="42" HeightRequest="4" Padding="0" HorizontalOptions="Center"
                        BackgroundColor="{StaticResource Gray500}" StrokeThickness="0" StrokeShape="RoundRectangle 2" />
                <Label Grid.Row="1" Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                <controls:SearchField Grid.Row="2" Placeholder="Cerca" TextChanged="OnSearchChanged"/>
                <CollectionView x:Name="ChoicesList" Grid.Row="3" ItemsSource="{Binding Items}" SelectionMode="None" HeightRequest="{Binding ListHeight}">
                    <CollectionView.EmptyView>
                        <Label Text="Nessun risultato. Prova un altro nome." Style="{StaticResource MutedLabel}" Margin="8,16" HorizontalTextAlignment="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="controls:ChoiceSelectionItem">
                            <Border Padding="0" Margin="0,0,0,6" HeightRequest="{Binding RowHeight}" StrokeThickness="0"
                                    BackgroundColor="{DynamicResource CanvasColor}"
                                    Stroke="{DynamicResource BorderColor}" StrokeShape="RoundRectangle 18">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAltColor}" />
                                        <Setter Property="StrokeThickness" Value="1" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid>
                                  <Button BackgroundColor="Transparent" BorderWidth="0" CornerRadius="18" Clicked="OnItemClicked"
                                          SemanticProperties.Description="{Binding Label}" SemanticProperties.Hint="{Binding SelectionHint}" />
                                  <Grid Padding="14,9" ColumnDefinitions="Auto,*,24" ColumnSpacing="12" InputTransparent="True">
                                    <Border IsVisible="{Binding HasIcon}" WidthRequest="40" HeightRequest="40" Padding="9" VerticalOptions="Center"
                                            StrokeShape="RoundRectangle 13" BackgroundColor="{Binding IconColor}"><Image Source="{Binding IconSource}" /></Border>
                                    <Path Grid.Column="2" IsVisible="{Binding IsSelected}" Data="M 2,9 L 7,14 L 17,3"
                                          Stroke="{DynamicResource TextColor}" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                                          WidthRequest="20" HeightRequest="18" VerticalOptions="Center" HorizontalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding Label}" FontSize="16" MaxLines="2" LineBreakMode="TailTruncation">
                                            <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True"><Setter Property="FontAttributes" Value="Bold" /></DataTrigger></Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" FontSize="12" Style="{StaticResource MutedLabel}" MaxLines="1" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                  </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button Grid.Row="4" Text="Annulla" Style="{StaticResource SecondaryButton}" Clicked="OnCancelClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
