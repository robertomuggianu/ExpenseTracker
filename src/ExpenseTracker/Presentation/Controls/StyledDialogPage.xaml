<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Presentation.Controls.StyledDialogPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#B0000000">
    <Grid Padding="24">
        <Border VerticalOptions="Center" Padding="22"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
                Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                StrokeShape="RoundRectangle 24">
            <VerticalStackLayout Spacing="16">
                <Border WidthRequest="48" HeightRequest="48" Padding="0" HorizontalOptions="Start"
                        BackgroundColor="#24E2383F" StrokeThickness="0" StrokeShape="RoundRectangle 15">
                    <Label Text="!" TextColor="{StaticResource PrimaryGlow}" FontSize="24" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <Label x:Name="TitleLabel" Style="{StaticResource SectionTitle}" />
                <Label x:Name="MessageLabel" Style="{StaticResource MutedLabel}" FontSize="15" LineHeight="1.25" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button x:Name="CancelButton" Text="Annulla" Style="{StaticResource SecondaryButton}" Clicked="OnCancelClicked" />
                    <Button x:Name="AcceptButton" Grid.Column="1" Text="OK" Clicked="OnAcceptClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
